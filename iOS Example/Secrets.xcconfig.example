//
//  Secrets.xcconfig.example
//  iOS Example
//
//  Copy this file to Secrets.xcconfig (gitignored) and fill in your own
//  Untappd API credentials from https://untappd.com/api/register before
//  building the iOS Example app.
//

UNTAPPD_CLIENT_ID = your_client_id_here
UNTAPPD_CLIENT_SECRET = your_client_secret_here
